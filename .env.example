# Copy this file to `.env` and fill in real values. Never commit `.env` itself.

# --- AI providers ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Claude model used to write the actual answer (needs to be careful/accurate).
# Phase 1: using Haiku 4.5 for both roles; swap to a Sonnet model here later if
# quality testing shows the main answer-writing step needs more capability.
ANTHROPIC_MAIN_MODEL=claude-haiku-4-5-20251001
# Cheaper/faster Claude model used only for the follow-up query rewrite step.
ANTHROPIC_REWRITE_MODEL=claude-haiku-4-5-20251001

# --- Qdrant (vector search) ---
# Local Docker default. Point this at a remote Qdrant instance in production.
QDRANT_URL=http://localhost:6333
COLLECTION_ALIAS=uae_hr_laws

# --- Postgres (provisioned in Phase 1, connected to for real starting Phase 3) ---
# USER/PASSWORD/DB are read by docker-compose.yml to set up the container —
# this is the Postgres SUPERUSER. HOST/PORT tell the app where to find it —
# 5434 matches docker-compose.yml's host-side port mapping (5433 was tried
# first but can collide with a native Postgres install some machines already
# have — see docker-compose.yml).
POSTGRES_USER=uae_hr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uae_hr
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# The APPLICATION connects as this separate, restricted role instead of the
# superuser above — it only has SELECT+INSERT on audit_logs (no UPDATE/DELETE),
# which is what actually enforces the audit trail being append-only (Section
# I2). Alembic migrations still use the superuser above, since they need to
# create/alter tables. This role must be created manually once per database —
# see docs/phase-3-tasks.md Section I2 for the exact GRANT statements.
APP_DB_USER=uae_hr_app
APP_DB_PASSWORD=
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- CORS ---
# JSON array of allowed frontend origins.
CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# --- Auth (Phase 3) ---
# Signs login tokens (JWTs). Must be a long, random, secret value — never a
# short or guessable string, and never committed with a real value here.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- Seed accounts (Phase 3, Section C) ---
# One Admin and one demo HR User account are created automatically the first
# time the app starts — no sign-up screen. Choose real passwords here; the
# app refuses to start if either password is left blank.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(16))"
SEED_ADMIN_EMAIL=admin@uae-hr.local
SEED_ADMIN_PASSWORD=
SEED_HR_EMAIL=hr.user@uae-hr.local
SEED_HR_PASSWORD=

# When true, the login page (Phase 8) may display the seeded demo credentials
# for convenience. Does not affect whether the accounts exist or how they're
# protected (see Section C4) — cosmetic only.
DEMO_MODE=true

# Set to true only when the app is served over HTTPS (any real deployment).
# Leave false for local HTTP development — browsers refuse to send a `Secure`
# cookie back over plain HTTP, which would break login entirely in dev.
COOKIE_SECURE=false

# --- Evaluation / LangSmith (optional, used by tests/evaluations.py and scripts/eval/*) ---
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGSMITH_WORKSPACE_ID=
LANGCHAIN_ENDPOINT=
